{
 "slug": "expense-review-gate",
 "title": "Expense review gate",
 "problem": "Decide whether an expense claim can be reimbursed automatically or must be held for a manager before any money moves.",
 "shape": "gate",
 "state_fields": [
  "expense"
 ],
 "questions": {
  "personal_in_nature": {
   "type": "noul",
   "instructions": "The expense looks personal rather than business-related"
  },
  "policy_exception": {
   "type": "noul",
   "instructions": "The description asks for, or admits to, an exception to the expense policy"
  },
  "receipt_missing": {
   "type": "noul",
   "instructions": "The claim explicitly states that the receipt is missing, lost, or unavailable"
  }
 },
 "thresholds": {
  "auto_limit_usd": {
   "value": 200,
   "why": "hard cap in code: arithmetic on the amount never goes to the model"
  },
  "personal_bar": {
   "value": 0.6,
   "why": "personal spend is a policy breach, hold early"
  },
  "exception_bar": {
   "value": 0.5,
   "why": "an admitted exception always needs a human"
  },
  "receipt_bar": {
   "value": 0.7,
   "why": "auditors need the receipt, but a mistaken hold is only a delay"
  },
  "clear_bar": {
   "value": 0.25,
   "why": "auto-approve only when every flag is clearly absent; the gray zone goes to a person"
  }
 },
 "outcomes": {
  "auto_approve": {
   "kind": "auto",
   "description": "Reimburse without a manager"
  },
  "hold_for_manager": {
   "kind": "review",
   "description": "Hold; a manager approves or rejects"
  }
 },
 "rules": [
  {
   "name": "hold_over_limit",
   "then": "hold_for_manager",
   "why": "amount is checked in code",
   "when": [
    {
     "state": "expense.amount_usd",
     "op": ">",
     "value": "$auto_limit_usd"
    }
   ]
  },
  {
   "name": "hold_personal",
   "then": "hold_for_manager",
   "why": "looks personal",
   "when": [
    {
     "q": "personal_in_nature",
     "field": "noul",
     "op": ">",
     "value": "$personal_bar"
    }
   ]
  },
  {
   "name": "hold_exception",
   "then": "hold_for_manager",
   "why": "policy exception requested",
   "when": [
    {
     "q": "policy_exception",
     "field": "noul",
     "op": ">",
     "value": "$exception_bar"
    }
   ]
  },
  {
   "name": "hold_no_receipt",
   "then": "hold_for_manager",
   "why": "no receipt",
   "when": [
    {
     "q": "receipt_missing",
     "field": "noul",
     "op": ">",
     "value": "$receipt_bar"
    }
   ]
  },
  {
   "name": "approve_clean",
   "then": "auto_approve",
   "why": "every flag clearly absent, under the cap",
   "when": [
    {
     "q": "personal_in_nature",
     "field": "noul",
     "op": "<",
     "value": "$clear_bar"
    },
    {
     "q": "policy_exception",
     "field": "noul",
     "op": "<",
     "value": "$clear_bar"
    },
    {
     "q": "receipt_missing",
     "field": "noul",
     "op": "<",
     "value": "$clear_bar"
    }
   ]
  }
 ],
 "default": {
  "outcome": "hold_for_manager",
  "why": "gray zone: not clearly bad, not clearly clean"
 },
 "candidates": [
  {
   "name": "One Noul: needs_review",
   "shape": "gate",
